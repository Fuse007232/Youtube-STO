# ─────────────────────────────────────────────────────────────
# Umgebungsvariablen – NUR Namen, KEINE echten Werte!
# Echte Werte gehören in:
#   • Vercel → Project → Settings → Environment Variables
#   • Claude-Cloud-Umgebung → Edit → Umgebungsvariablen
#   • lokal (nur falls nötig) in .env.local – wird nie committet
# Details: docs/PLAN.md, Abschnitt 5
# ─────────────────────────────────────────────────────────────

# Phase 1 – Datenquelle (optional): mock | youtube | database
# Leer lassen = automatisch: mit YOUTUBE_API_KEY echte Zahlen, sonst Beispieldaten.
DATA_SOURCE=

# Phase 2 – YouTube Data API
YOUTUBE_API_KEY=

# Phase 3 – Supabase (Projekt „youtube-dashboard“, Frankfurt)
# SUPABASE_URL ist kein Geheimnis: https://kdqxslwojkvhffhjctrv.supabase.co
SUPABASE_URL=
# Geheimer Server-Schlüssel (sb_secret_…) – Supabase → Project Settings → API Keys
SUPABASE_SECRET_KEY=
# Selbst erzeugtes Geheimwort (mind. 40 Zeichen) für /api/cron/snapshot
CRON_SECRET=

# Phase 4 – Veröffentlichung / Passwortschutz
DASHBOARD_PASSWORD=
SESSION_SECRET=
APP_URL=

# Phase 5 – Google OAuth (YouTube Analytics)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
